# ONE settings file for the whole project. Copy to .env (in this folder; git-ignored) and fill in.
# Read by the Python (consentledger.chain) and by Hardhat (contracts/hardhat.config.ts).
# Sepolia testnet only: a throwaway wallet that has NEVER held real funds.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_THROWAWAY_TEST_WALLET_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
# Optional: the contract to use. Default: the address recorded by the deployment in
# contracts/ignition/deployments/chain-<chain id>/deployed_addresses.json (Sepolia: 0x2De2...A4bF).
# CONSENT_REGISTRY_ADDRESS=
