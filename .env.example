# Copy to .env (git-ignored). Read by consentledger.chain and contracts/hardhat.config.ts.
# Sepolia only: use a throwaway wallet that has never held real funds.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_THROWAWAY_TEST_WALLET_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
# Optional on Sepolia (defaults to contracts/ignition/deployments/chain-11155111/); required on a local chain.
# CONSENT_REGISTRY_ADDRESS=
